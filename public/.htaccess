# Apache config for Hetzner webhosting (replaces the Netlify/Cloudflare-style _headers file)

# Force HTTPS and the canonical apex host (single 301 hop)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.danielkaufmann\.at$ [NC]
  RewriteRule ^ https://danielkaufmann.at%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # HSTS, staged rollout. Browsers cache this, so it cannot be undone quickly.
  # Steps: 300 s (done), 86400 s = 1 day (done), 604800 s = 1 week (current), then
  # 31536000 = 1 year, waiting for the previous step to run cleanly each time.
  # includeSubDomains and preload are deliberately left out: vienna-districts and
  # master-thesis are separate Netlify sites.
  Header always set Strict-Transport-Security "max-age=604800"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

  # Astro emits content-hashed files under /_astro/
  <FilesMatch "^.*$">
    SetEnvIf Request_URI "^/_astro/" ASTRO_ASSET
  </FilesMatch>
  Header set Cache-Control "public, max-age=31536000, immutable" env=ASTRO_ASSET
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>

# Hide the FTP deploy action's sync state file
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
